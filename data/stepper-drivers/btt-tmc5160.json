{
  "id": "btt-tmc5160",
  "name": "TMC5160",
  "manufacturer": "BigTreeTech",
  "description": "BigTreeTech's SilentStepStick-compatible TMC5160 driver module (the wiki lists the on-board silicon as \"TMC5160T V1.0\"). It is described by BigTreeTech as a \"high-power stepper motor driving control chip, which has externally expanded power MOS tube\", giving it a wider supply voltage and higher coil-current headroom than the integrated-MOSFET TMC22xx StepSticks.",
  "driverInterface": "SPI",
  "formFactor": "stepstick",
  "baseChip": "tmc5160",
  "electricalSpecs": {
    "supplyVoltageMin": 8,
    "supplyVoltageMax": 40,
    "rmsCurrentMax": 3.1,
    "peakCurrentMax": 4.4,
    "senseResistor": 0.075
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop2",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard2",
    "dcStep": true,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc5160",
    "driverInterface": "SPI",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
  "physicalSpecs": {
    "dimensions": "15.3 × 20.4 mm"
  },
