    "supplyVoltageMin": 4.5,
    "supplyVoltageMax": 36,
    "rmsCurrentMax": 2.1,
    "peakCurrentMax": 3.0,
    "logicVoltageMin": 3.0,
    "logicVoltageMax": 5.25
  },
  "featureSpecs": {
    "microstepsMax": 256,
