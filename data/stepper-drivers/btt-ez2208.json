{
  "id": "btt-ez2208",
  "name": "BIGTREETECH EZ2208",
  "manufacturer": "BIGTREETECH",
  "description": "BIGTREETECH's EZ-form-factor stepper driver module based on the Trinamic TMC2208. The BTT wiki lists a 12V/24VDC voltage range, 1.2A built-in drive current with a 2A peak, 256 microsteps per full step with interpolation, and stealthChop2 plus spreadCycle chopper modes over a single-wire UART interface.",
  "driverInterface": "UART",
  "formFactor": "ez",
  "baseChip": "tmc2208",
  "electricalSpecs": {
    "supplyVoltageMin": 12,
    "supplyVoltageMax": 24,
    "rmsCurrentMax": 1.2,
    "peakCurrentMax": 2
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop2",
    "spreadCycle": true,
    "coolStep": false,
    "stallGuard": "none",
    "dcStep": false,
    "sensorlessHoming": false
  },
  "klipperSpecs": {
    "section": "tmc2208",
    "driverInterface": "UART",
    "supportsDiagPin": false,
    "supportsSensorlessHoming": false
  },
