{
  "id": "btt-tmc5160t-plus",
  "name": "BigTreeTech TMC5160T Plus",
  "manufacturer": "BigTreeTech",
  "description": "BigTreeTech's TMC5160T Plus is a high-power external stepper driver module built around a TMC5160-TA, with \"8 high-power MOSFETs separately mounted on the board\" rated for \"100V voltage resistance, 93A current resistance\". Its operating modes are described as \"standalone mode, UART mode, and SPI mode selectable\" with an \"Encoder interface reserved for DIY usage\". It is delivered as a standalone heatsinked module rather than a pluggable StepStick.",
  "driverInterface": "SPI",
  "formFactor": "external",
  "baseChip": "tmc5160",
  "electricalSpecs": {
    "supplyVoltageMin": 8,
    "supplyVoltageMax": 56,
    "rmsCurrentMax": 10.6,
    "peakCurrentMax": 15,
    "senseResistor": 0.022
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop2",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard2",
    "dcStep": true,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc5160",
    "driverInterface": "SPI",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
  "physicalSpecs": {
    "dimensions": "64 × 56 × 32.55 mm (with case); 58 × 50 × 28 mm (bare)"
  },
