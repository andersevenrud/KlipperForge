{
  "id": "btt-ez2130",
  "name": "BigTreeTech EZ2130",
  "manufacturer": "BigTreeTech",
  "description": "BigTreeTech's EZ-form-factor stepper driver module based on the Trinamic TMC2130. The BTT wiki lists a 12V/24VDC voltage range, 3.3V/5V logic voltage, 1.2A operating current with a 2A peak, up to 256 microsteps per full step, and stealthChop, spreadCycle and coolStep features over a Step/Dir + SPI interface.",
  "driverInterface": "SPI",
  "formFactor": "ez",
  "baseChip": "tmc2130",
  "electricalSpecs": {
    "supplyVoltageMin": 12,
    "supplyVoltageMax": 24,
    "rmsCurrentMax": 1.2,
    "peakCurrentMax": 2,
    "logicVoltageMin": 3.3,
    "logicVoltageMax": 5
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard2",
    "dcStep": true,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc2130",
    "driverInterface": "SPI",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
