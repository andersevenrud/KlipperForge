{
  "id": "tmc2209",
  "name": "TMC2209",
  "manufacturer": "Analog Devices (Trinamic)",
  "description": "The TMC2209 is a two-phase stepper motor driver with integrated MOSFETs, a single-wire UART interface and Step/Dir input. It builds on the TMC2208 by adding stallGuard4 sensorless load detection for use as a virtual endstop (sensorless homing) together with coolStep adaptive current control, while retaining stealthChop2 and spreadCycle. The TMC2209 is the most common smart driver on modern hobbyist 3D printer control boards.",
  "driverInterface": "UART",
  "formFactor": "chip",
  "electricalSpecs": {
    "supplyVoltageMin": 5.5,
    "supplyVoltageMax": 29,
    "rmsCurrentMax": 2,
    "peakCurrentMax": 2.8,
    "logicVoltageMin": 3,
    "logicVoltageMax": 5.25
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop2",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard4",
    "dcStep": false,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc2209",
    "driverInterface": "UART",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
  "physicalSpecs": {
    "packageType": "QFN-28",
    "dimensions": "5 × 5 mm",
    "operatingTemperature": "-40 to 125 °C (junction)"
  },
