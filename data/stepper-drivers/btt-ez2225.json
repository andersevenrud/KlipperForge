{
  "id": "btt-ez2225",
  "name": "BIGTREETECH EZ2225",
  "manufacturer": "BIGTREETECH",
  "description": "BIGTREETECH's EZ-Driver form-factor module built around the TMC2225, an ultra-silent motor driver IC for two-phase stepper motors. Supports 2-phase stepper motors up to 2A coil current (peak) over a 4.75-36 V DC range, with StealthChop2 silent operation, SpreadCycle dynamic chopper, and single-wire UART plus OTP for advanced configuration.",
  "driverInterface": "UART",
  "formFactor": "ez",
  "baseChip": "tmc2208",
  "electricalSpecs": {
    "supplyVoltageMin": 4.75,
    "supplyVoltageMax": 36,
    "rmsCurrentMax": 1.4,
    "peakCurrentMax": 2
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop2",
    "spreadCycle": true
  },
  "klipperSpecs": {
    "section": "tmc2208",
    "driverInterface": "UART",
    "supportsDiagPin": false,
    "supportsSensorlessHoming": false
  },
