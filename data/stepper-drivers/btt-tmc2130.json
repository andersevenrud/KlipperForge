{
  "id": "btt-tmc2130",
  "name": "BIGTREETECH TMC2130",
  "manufacturer": "BIGTREETECH",
  "description": "BIGTREETECH's SilentStepStick-compatible TMC2130 driver module. Based on Trinamic's TMC2130 chip with SPI and Step/Dir control. Latest revision is V3.0; earlier V1.1 and V2.0 revisions have their own dedicated legacy repositories under the bigtreetech GitHub organization. VREF is adjustable via an onboard potentiometer.",
  "driverInterface": "SPI",
  "formFactor": "stepstick",
  "baseChip": "tmc2130",
  "electricalSpecs": {
    "supplyVoltageMin": 12,
    "supplyVoltageMax": 24,
    "rmsCurrentMax": 1.2,
    "peakCurrentMax": 2,
    "senseResistor": 0.11
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard2",
    "dcStep": true,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc2130",
    "driverInterface": "SPI",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
