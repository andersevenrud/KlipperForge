{
  "id": "btt-tmc2130",
  "name": "TMC2130",
  "manufacturer": "BigTreeTech",
  "description": "BigTreeTech's SilentStepStick-compatible TMC2130 driver module. Based on Trinamic's TMC2130 chip with SPI and Step/Dir control, stealthChop for quiet operation and spreadCycle for dynamic motor control. Accepts 12V/24V DC input and is rated for 1.2 A motor current (2 A peak). Logic voltage is 3.3V/5V. VREF is adjustable via an onboard potentiometer and defaults to 1 V (±0.2).",
  "driverInterface": "SPI",
  "formFactor": "stepstick",
  "baseChip": "tmc2130",
  "electricalSpecs": {
    "supplyVoltageMin": 12,
    "supplyVoltageMax": 24,
    "rmsCurrentMax": 1.2,
    "peakCurrentMax": 2,
    "logicVoltageMin": 3.3,
    "logicVoltageMax": 5,
    "senseResistor": 0.11
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard2",
    "dcStep": true,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc2130",
    "driverInterface": "SPI",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
  "unverified": ["stallGuard", "dcStep", "sensorlessHoming"],
