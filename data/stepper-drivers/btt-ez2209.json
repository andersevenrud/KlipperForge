{
  "id": "btt-ez2209",
  "name": "BigTreeTech EZ2209",
  "manufacturer": "BigTreeTech",
  "description": "BigTreeTech's EZ-form-factor stepper driver module based on the Trinamic TMC2209. The BTT wiki lists a 4.75V-28V DC supply range, 2A RMS current with a 2.8A peak, up to 256 microsteps per full step, and StealthChop2, SpreadCycle, CoolStep and StallGuard4 features over STEP/DIR or UART. The upstream repository folder is named EZZ2209 (double Z) while BigTreeTech's wiki and documentation refer to the product as EZ2209.",
  "driverInterface": "UART",
  "formFactor": "ez",
  "baseChip": "tmc2209",
  "electricalSpecs": {
    "supplyVoltageMin": 4.75,
    "supplyVoltageMax": 28,
    "rmsCurrentMax": 2,
    "peakCurrentMax": 2.8
  },
  "featureSpecs": {
    "microstepsMax": 256,
    "interpolationTo256": true,
    "stealthChop": "stealthChop2",
    "spreadCycle": true,
    "coolStep": true,
    "stallGuard": "stallGuard4",
    "dcStep": false,
    "sensorlessHoming": true
  },
  "klipperSpecs": {
    "section": "tmc2209",
    "driverInterface": "UART",
    "supportsDiagPin": true,
    "supportsSensorlessHoming": true
  },
  "physicalSpecs": {
    "dimensions": "15.24 × 20.32 mm"
  },
  "unverified": ["senseResistor"],
  "references": [
