{
  "id": "bd-sensor",
  "name": "BD Sensor",
  "manufacturer": "markniu (PandaPi3D)",
  "description": "The BD Sensor is an ultra-thin eddy current distance sensor that mounts directly onto the hotend using adhesive. It communicates via a 2-wire I2C-like interface and requires only two signal pins on the MCU. Its extremely thin profile allows it to be mounted between the hotend and the heater block without affecting the toolhead's form factor.",
  "probeType": "eddy-current",
