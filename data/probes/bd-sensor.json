    "operatingVoltage": "3.3-5V DC",
    "signalType": "I2C (2-wire serial)",
    "currentDraw": "20mA"
  },
  "performanceSpecs": {
    "repeatability": "±0.005mm",
    "triggerDistance": "0.5-4mm",
    "bedCompatibility": ["spring steel sheet", "PEI on spring steel", "textured PEI on spring steel", "aluminum"],
    "bedCompatibilityNote": "Eddy current probes require a conductive surface. They cannot detect non-conductive materials like bare glass or G10/FR4 without a conductive layer underneath.",
    "temperatureCompensation": false,
    "multiPoint": true
  },
  "physicalSpecs": {
    "dimensions": "22.0 × 14.0 × 1.2mm",
    "weight": 1,
    "mountType": "adhesive mount to hotend"
