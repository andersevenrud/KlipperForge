    "variants[0].defaults.sections[10].data.pid_kd",
    "variants[0].defaults.sections[13].data.pin",
    "variants[0].defaults.sections[13].data.z_offset",
    "variants[0].defaults.sections[13].data.speed",
    "variants[0].defaults.sections[14].data.home_xy_position",
    "variants[0].defaults.sections[14].data.speed",
    "variants[0].defaults.sections[14].data.z_hop",
    "variants[0].defaults.sections[14].data.z_hop_speed",
    "variants[0].defaults.sections[15].data.speed",
    "variants[0].defaults.sections[15].data.horizontal_move_z",
    "variants[0].defaults.sections[15].data.mesh_min",
    "variants[0].defaults.sections[15].data.mesh_max",
    "variants[0].defaults.sections[15].data.probe_count",
