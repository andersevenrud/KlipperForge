{
  "id": "ender-3",
  "name": "Ender 3",
  "manufacturer": "Creality",
  "description": "Popular budget-friendly cartesian 3D printer. This preset assumes the stock v4.2.2/v4.2.7 mainboard has been replaced with a BIGTREETECH SKR Mini E3 V3.0, which is the most common Klipper upgrade path.",
  "equipment": [
    { "category": "mcu-boards", "id": "btt-skr-mini-e3-v3", "label": "BTT SKR Mini E3 V3.0", "role": "Main MCU" },
    { "category": "hotends", "id": "creality-mk8", "label": "Creality MK8", "role": "Hotend" },
    { "category": "extruders", "label": "Stock Plastic Bowden Extruder", "role": "Extruder" },
    { "category": "stepper-motors", "id": "creality-42-34", "label": "Creality 42-34", "role": "X/Y/Z Motors" },
    { "category": "stepper-motors", "id": "creality-42-40", "label": "Creality 42-40", "role": "Extruder Motor" }
  ],
