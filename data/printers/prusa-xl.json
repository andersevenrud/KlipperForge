{
  "id": "prusa-xl",
  "name": "Prusa XL",
  "manufacturer": "Prusa Research",
  "description": "Large-format CoreXY 3D printer with XLBuddy mainboard (STM32F407), TMC2130 SPI drivers (shared software SPI bus: sclk PC10 / mosi PC12 / miso PC11), Nextruder toolhead on Dwarf board, and a 16-zone MODBUS-controlled heated bed. **Experimental — requires the KlipperXL community project** (https://github.com/racoutlaw/KlipperXL) for MODBUS Dwarf communication, loadcell probe, and multi-toolhead control. Standard upstream Klipper does not ship a config for the XL. Pin mappings, motor currents, and bed_mesh parameters are taken from KlipperXL master; Dwarf-side values (extruder heater, hotend thermistor, part-cooling fan, filament sensor) are kept as mainboard placeholders since they actually live on the Dwarf over a custom MODBUS bus and cannot be represented in standard Klipper sections. Verify every value against your hardware before flashing.",
  "equipment": [
    { "category": "mcu-boards", "id": "prusa-xbuddy", "label": "Prusa xBuddy Board", "role": "Main MCU" },
    { "category": "hotends", "id": "prusa-nextruder", "label": "Prusa Nextruder", "role": "Hotend" },
    { "category": "extruders", "id": "prusa-nextruder", "label": "Prusa Nextruder", "role": "Extruder" },
    { "category": "probes", "label": "HX717 Loadcell (nozzle)", "role": "Z Probe" }
  ],
  "variants": [
    {
      "id": "single",
      "name": "Single Toolhead",
      "kinematics": "corexy",
      "bedSize": { "x": 360, "y": 360, "z": 360 },
      "defaults": {
        "mcuBoards": [{ "boardId": "prusa-xbuddy", "alias": "" }],
        "sections": [
          {
            "definitionId": "printer",
            "data": {
              "kinematics": "corexy",
              "max_velocity": 400,
              "max_accel": 1800,
              "max_z_velocity": 12,
              "max_z_accel": 200,
              "square_corner_velocity": 8
            }
          },
          {
            "definitionId": "mcu",
            "data": {
              "serial": "/dev/serial/by-id/usb-Klipper_stm32f407xx_placeholder-if00",
              "restart_method": "command"
            }
          },
          {
            "definitionId": "stepper",
            "instanceName": "x",
            "data": {
              "step_pin": "PD7",
              "dir_pin": "PD6",
              "enable_pin": "!PB9",
              "microsteps": 16,
              "rotation_distance": 40,
              "endstop_pin": "PE13",
              "position_min": -8,
              "position_endstop": -8,
              "position_max": 361,
              "homing_speed": 52,
              "homing_retract_dist": 20,
              "second_homing_speed": 52,
              "homing_positive_dir": false
            }
          },
          {
            "definitionId": "tmc2130",
            "instanceName": "stepper_x",
            "data": {
              "cs_pin": "PG15",
              "spi_software_sclk_pin": "PC10",
              "spi_software_mosi_pin": "PC12",
              "spi_software_miso_pin": "PC11",
              "run_current": 0.65,
              "hold_current": 0.65,
              "stealthchop_threshold": 0,
              "interpolate": true,
              "sense_resistor": 0.22,
              "driver_SGT": 1,
              "driver_TBL": 2,
              "driver_TOFF": 3,
              "driver_HEND": 1,
              "driver_HSTRT": 5
            }
          },
          {
            "definitionId": "stepper",
            "instanceName": "y",
            "data": {
              "step_pin": "PD5",
              "dir_pin": "PD4",
              "enable_pin": "!PB9",
              "microsteps": 16,
              "rotation_distance": 40,
              "endstop_pin": "PG9",
              "position_min": -9,
              "position_endstop": -9,
              "position_max": 461,
              "homing_speed": 52,
              "homing_retract_dist": 20,
              "second_homing_speed": 52,
              "homing_positive_dir": false
            }
          },
          {
            "definitionId": "tmc2130",
            "instanceName": "stepper_y",
            "data": {
              "cs_pin": "PB5",
              "spi_software_sclk_pin": "PC10",
              "spi_software_mosi_pin": "PC12",
              "spi_software_miso_pin": "PC11",
              "run_current": 0.65,
              "hold_current": 0.65,
              "stealthchop_threshold": 0,
              "interpolate": true,
              "sense_resistor": 0.22,
              "driver_SGT": 1,
              "driver_TBL": 2,
              "driver_TOFF": 3,
              "driver_HEND": 1,
              "driver_HSTRT": 5
            }
          },
          {
            "definitionId": "stepper",
            "instanceName": "z",
            "data": {
              "step_pin": "PD3",
              "dir_pin": "!PD2",
              "enable_pin": "!PB8",
              "microsteps": 16,
              "rotation_distance": 4,
              "endstop_pin": "^PB4",
              "position_endstop": 0,
              "position_min": -9,
              "position_max": 360,
              "homing_speed": 8,
              "second_homing_speed": 1
            }
          },
          {
            "definitionId": "tmc2130",
            "instanceName": "stepper_z",
            "data": {
              "cs_pin": "PG10",
              "spi_software_sclk_pin": "PC10",
              "spi_software_mosi_pin": "PC12",
              "spi_software_miso_pin": "PC11",
              "run_current": 0.7,
              "hold_current": 0.7,
              "stealthchop_threshold": 0,
              "interpolate": true,
              "sense_resistor": 0.22,
              "diag1_pin": "^PB4",
              "driver_TBL": 2,
              "driver_TOFF": 3,
              "driver_HEND": 1,
              "driver_HSTRT": 5
            }
          },
          {
            "definitionId": "extruder",
            "data": {
              "step_pin": "PD1",
              "dir_pin": "PD0",
              "enable_pin": "!PD10",
              "microsteps": 16,
              "rotation_distance": 8.42,
              "nozzle_diameter": 0.4,
              "filament_diameter": 1.75,
              "heater_pin": "PB1",
              "sensor_type": "ATC Semitec 104NT-4-R025H42G",
              "sensor_pin": "PC0",
              "min_temp": 5,
              "max_temp": 305,
              "control": "pid",
              "pid_kp": 30,
              "pid_ki": 3,
              "pid_kd": 80,
              "pressure_advance": 0.025,
              "max_extrude_only_distance": 300
            }
          },
          {
            "definitionId": "heater_bed",
            "data": {
              "heater_pin": "PB0",
              "sensor_type": "ATC Semitec 104NT-4-R025H42G",
              "sensor_pin": "PA4",
              "min_temp": 5,
              "max_temp": 120,
              "control": "pid",
              "pid_kp": 160.97,
              "pid_ki": 14.07,
              "pid_kd": 460.39
            }
          },
          {
            "definitionId": "fan",
            "data": {
              "pin": "PE11"
            }
          },
          {
            "definitionId": "bed_mesh",
            "data": {
              "speed": 150,
              "horizontal_move_z": 0.5,
              "mesh_min": "30, 30",
              "mesh_max": "330, 330",
              "probe_count": "12, 12",
              "algorithm": "bicubic",
              "fade_start": 1,
              "fade_end": 10
            }
          },
          {
            "definitionId": "temperature_sensor",
            "instanceName": "xlbuddy_mcu",
            "data": {
              "sensor_type": "temperature_mcu",
              "min_temp": 0,
              "max_temp": 100
            }
          },
          {
            "definitionId": "temperature_sensor",
            "instanceName": "raspberry_pi",
            "data": {
              "sensor_type": "temperature_host",
              "min_temp": 0,
              "max_temp": 100
            }
          },
          {
            "definitionId": "input_shaper",
            "data": {
              "shaper_type_x": "mzv",
              "shaper_freq_x": 35.8,
              "shaper_type_y": "mzv",
              "shaper_freq_y": 35.4
            }
          },
          {
            "definitionId": "idle_timeout",
            "data": {
              "timeout": 1800
            }
          },
          {
            "definitionId": "force_move",
            "data": {
              "enable_force_move": true
            }
          },
          { "definitionId": "virtual_sdcard", "data": { "path": "~/printer_data/gcodes" } },
          { "definitionId": "pause_resume", "data": {} },
          { "definitionId": "display_status", "data": {} },
          { "definitionId": "exclude_object", "data": {} },
          { "definitionId": "respond", "data": {} },
          { "definitionId": "gcode_arcs", "data": {} }
        ]
      }
    },
