{
  "id": "prusa-xl",
  "name": "Prusa XL",
  "manufacturer": "Prusa Research",
  "description": "Large-format CoreXY 3D printer with xBuddy mainboard (STM32F407, TMC2130 SPI drivers), Nextruder toolhead on Dwarf board, and segmented heated bed (16 individually controlled 90x90mm tiles). Supports up to 5 toolheads for multi-material printing. Pin mappings derived from Prusa firmware source. Note: multi-tool and Dwarf board communication requires the KlipperXL community project — standard Klipper does not support the RS485/MODBUS protocol used for toolhead control.",
  "equipment": [
    { "category": "mcu-boards", "label": "xBuddy Board", "role": "Main MCU" },
    { "category": "hotends", "id": "prusa-nextruder", "label": "Prusa Nextruder", "role": "Hotend" },
    { "category": "extruders", "id": "prusa-nextruder", "label": "Prusa Nextruder", "role": "Extruder" },
    { "category": "probes", "label": "Loadcell", "role": "Z Probe" }
  ],
