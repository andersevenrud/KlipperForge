{
  "id": "prusa-mk4s",
  "name": "Prusa MK4S",
  "manufacturer": "Prusa Research",
  "kinematics": "cartesian",
  "description": "Cartesian 3D printer with xBuddy board (STM32F427, TMC2130 SPI drivers), Nextruder direct drive extruder with load cell probing, and 24V heated bed. Also covers the original MK4 which shares the same board and frame. Note: the xBuddy board has no official Klipper config — pin mappings are derived from Prusa firmware source code.",
  "bedSize": { "x": 250, "y": 210, "z": 220 },
  "equipment": [
    { "category": "mcu-boards", "label": "xBuddy Board", "role": "Main MCU" },
    { "category": "hotends", "id": "prusa-nextruder", "label": "Prusa Nextruder", "role": "Hotend" },
    { "category": "extruders", "id": "prusa-nextruder", "label": "Prusa Nextruder", "role": "Extruder" },
    { "category": "probes", "label": "Loadcell", "role": "Z Probe" }
  ],
  "defaults": {
    "sections": [
      {
        "definitionId": "printer",
        "data": {
          "kinematics": "cartesian",
          "max_velocity": 300,
          "max_accel": 1250,
          "max_z_velocity": 40,
          "max_z_accel": 200
        }
      },
      {
        "definitionId": "mcu",
        "data": {
          "serial": "/dev/serial/by-id/usb-Prusa_Research__a.s._Original_Prusa_MK4_placeholder"
        }
      },
      {
        "definitionId": "stepper",
        "instanceName": "x",
        "data": {
          "step_pin": "PD7",
          "dir_pin": "PD6",
          "enable_pin": "!PB9",
          "microsteps": 16,
          "rotation_distance": 32,
          "endstop_pin": "tmc2130_stepper_x:virtual_endstop",
          "position_endstop": 250,
          "position_min": -1,
          "position_max": 251,
          "homing_speed": 50,
          "homing_retract_dist": 0
        }
      },
      {
        "definitionId": "stepper",
        "instanceName": "y",
        "data": {
          "step_pin": "PD5",
          "dir_pin": "PD4",
          "enable_pin": "!PB9",
          "microsteps": 16,
          "rotation_distance": 32,
          "endstop_pin": "tmc2130_stepper_y:virtual_endstop",
          "position_endstop": -4,
          "position_min": -4,
          "position_max": 211,
          "homing_speed": 50,
          "homing_retract_dist": 0
        }
      },
      {
        "definitionId": "stepper",
        "instanceName": "z",
        "data": {
          "step_pin": "PD3",
          "dir_pin": "PD2",
          "enable_pin": "!PB8",
          "microsteps": 16,
          "rotation_distance": 8,
          "endstop_pin": "probe:z_virtual_endstop",
          "position_min": 0,
          "position_max": 221,
          "homing_speed": 13.333
        }
      },
      {
        "definitionId": "extruder",
        "data": {
          "step_pin": "PD1",
          "dir_pin": "PD0",
          "enable_pin": "!PD10",
          "microsteps": 16,
          "rotation_distance": 8.421,
          "nozzle_diameter": 0.4,
          "filament_diameter": 1.75,
          "heater_pin": "PB1",
          "sensor_type": "ATC Semitec 104GT-2",
          "sensor_pin": "PC0",
          "min_temp": 10,
          "max_temp": 305,
          "control": "pid",
          "pid_kp": 7,
          "pid_ki": 0.5,
          "pid_kd": 45
        }
      },
      {
        "definitionId": "heater_bed",
        "data": {
          "heater_pin": "PB0",
          "sensor_type": "EPCOS 100K B57560G104F",
          "sensor_pin": "PA4",
          "min_temp": 10,
          "max_temp": 110,
          "control": "pid",
          "pid_kp": 120,
          "pid_ki": 1.5,
          "pid_kd": 600
        }
      },
      {
        "definitionId": "fan",
        "data": {
          "pin": "PE11"
        }
      }
    ]
  },
  "references": [
    {
