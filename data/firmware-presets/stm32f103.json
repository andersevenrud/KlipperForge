{
  "mcuFamily": "STM32F103",
  "mcuPatterns": ["STM32F103"],
  "outputFile": "klipper.bin",
  "flashMethods": ["dfu", "serial"],
  "base": {
    "CONFIG_MACH_STM32": "y",
    "CONFIG_MACH_STM32F103": "y",
    "CONFIG_STM32_CLOCK_REF_8M": "y"
  },
  "interfaces": {
    "usb": {
      "label": "USB (on PA11/PA12)",
      "config": {
        "CONFIG_STM32_USB_PA11_PA12": "y",
        "CONFIG_USB": "y"
      }
    },
    "serial": {
      "label": "Serial (on USART1 PA10/PA9)",
      "config": {
        "CONFIG_STM32_SERIAL_USART1": "y",
        "CONFIG_SERIAL": "y"
      }
    }
  },
  "bootloaderOffsets": {
    "none": {
      "label": "No bootloader",
      "flashAddress": "0x08000000",
      "config": {
        "CONFIG_STM32_FLASH_START_0000": "y"
      }
    },
    "28KiB": {
      "label": "28KiB bootloader",
      "flashAddress": "0x08007000",
      "config": {
        "CONFIG_STM32_FLASH_START_7000": "y"
      }
    }
  },
  "clockRefs": {
    "8MHz": {
      "label": "8MHz crystal"
    }
  }
}
