{
  "mcuFamily": "RP2040",
  "mcuPatterns": ["RP2040"],
  "outputFile": "klipper.uf2",
  "flashMethods": ["uf2"],
  "base": {
    "CONFIG_MACH_RP2040": "y",
    "CONFIG_RP2040_HAVE_STAGE2": "y"
  },
  "interfaces": {
    "usb": {
      "label": "USB",
      "config": {
        "CONFIG_USB": "y"
      }
    },
    "can": {
      "label": "CAN bus",
      "config": {
        "CONFIG_RPXXXX_CANBUS": "y",
        "CONFIG_RPXXXX_CANBUS_GPIO_RX": "4",
        "CONFIG_RPXXXX_CANBUS_GPIO_TX": "5"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    },
    "usb-to-can": {
      "label": "USB to CAN bus bridge",
      "config": {
        "CONFIG_RPXXXX_USBCANBUS": "y",
        "CONFIG_RPXXXX_CANBUS_GPIO_RX": "4",
        "CONFIG_RPXXXX_CANBUS_GPIO_TX": "5"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    }
  },
  "bootloaderOffsets": {
    "none": {
      "label": "No bootloader (16KiB SRAM)"
    }
  },
  "clockRefs": {
    "12MHz": {
      "label": "12MHz crystal"
    }
  }
}
