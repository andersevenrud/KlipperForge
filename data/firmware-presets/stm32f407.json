{
  "mcuFamily": "STM32F407",
  "mcuPatterns": ["STM32F407"],
  "outputFile": "klipper.bin",
  "flashMethods": ["dfu", "serial"],
  "base": {
    "CONFIG_MACH_STM32": "y",
    "CONFIG_MACH_STM32F407": "y",
    "CONFIG_STM32_CLOCK_REF_8M": "y"
  },
  "interfaces": {
    "usb": {
      "label": "USB (on PA11/PA12)",
      "config": {
        "CONFIG_STM32_USB_PA11_PA12": "y",
        "CONFIG_USB": "y"
      }
    },
    "can": {
      "label": "CAN bus (on PD0/PD1)",
      "config": {
        "CONFIG_STM32_CANBUS_PD0_PD1": "y"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    }
  },
  "bootloaderOffsets": {
    "none": {
      "label": "No bootloader",
      "flashAddress": "0x08000000",
      "config": {
        "CONFIG_STM32_FLASH_START_0000": "y"
      }
    },
    "32KiB": {
      "label": "32KiB bootloader",
      "flashAddress": "0x08008000",
      "config": {
        "CONFIG_STM32_FLASH_START_8000": "y"
      }
    },
    "64KiB": {
      "label": "64KiB bootloader",
      "flashAddress": "0x08010000",
      "config": {
        "CONFIG_STM32_FLASH_START_10000": "y"
      }
    }
  },
  "clockRefs": {
    "8MHz": {
      "label": "8MHz crystal"
    },
    "12MHz": {
      "label": "12MHz crystal",
      "config": {
        "CONFIG_STM32_CLOCK_REF_12M": "y"
      }
    }
  }
}
