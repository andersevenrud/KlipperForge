{
  "mcuFamily": "STM32H743",
  "mcuPatterns": ["STM32H743"],
  "outputFile": "klipper.bin",
  "flashMethods": ["dfu", "serial"],
  "base": {
    "CONFIG_MACH_STM32": "y",
    "CONFIG_MACH_STM32H743": "y",
    "CONFIG_STM32_CLOCK_REF_25M": "y"
  },
  "interfaces": {
    "usb": {
      "label": "USB (on PA11/PA12)",
      "config": {
        "CONFIG_STM32_USB_PA11_PA12": "y",
        "CONFIG_USB": "y"
      }
    },
    "can": {
      "label": "CAN bus (on PD0/PD1)",
      "config": {
        "CONFIG_STM32_CANBUS_PD0_PD1": "y"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    },
    "usb-to-can": {
      "label": "USB to CAN bus bridge (on PD0/PD1)",
      "config": {
        "CONFIG_STM32_USBCANBUS_PA11_PA12": "y",
        "CONFIG_STM32_CMENU_CANBUS_PD0_PD1": "y"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    }
  },
  "bootloaderOffsets": {
    "none": {
      "label": "No bootloader",
      "flashAddress": "0x08000000",
      "config": {
        "CONFIG_STM32_FLASH_START_0000": "y"
      }
    },
    "128KiB": {
      "label": "128KiB bootloader",
      "flashAddress": "0x08020000",
      "config": {
        "CONFIG_STM32_FLASH_START_20000": "y"
      }
    }
  },
  "clockRefs": {
    "25MHz": {
      "label": "25MHz crystal"
    }
  }
}
