{
  "mcuFamily": "STM32G0B1",
  "mcuPatterns": ["STM32G0B1"],
  "outputFile": "klipper.bin",
  "flashMethods": ["dfu", "serial"],
  "base": {
    "CONFIG_MACH_STM32": "y",
    "CONFIG_MACH_STM32G0B1": "y",
    "CONFIG_STM32_CLOCK_REF_8M": "y"
  },
  "interfaces": {
    "usb": {
      "label": "USB (on PA11/PA12)",
      "config": {
        "CONFIG_STM32_USB_PA11_PA12": "y",
        "CONFIG_USB": "y"
      }
    },
    "can": {
      "label": "CAN bus (on PB0/PB1)",
      "config": {
        "CONFIG_STM32_CANBUS_PB0_PB1": "y"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    },
    "usb-to-can": {
      "label": "USB to CAN bus bridge (on PB0/PB1)",
      "config": {
        "CONFIG_STM32_USBCANBUS_PA11_PA12": "y",
        "CONFIG_STM32_CMENU_CANBUS_PB0_PB1": "y"
      },
      "options": [
        {
          "key": "CONFIG_CANBUS_FREQUENCY",
          "label": "CAN bus speed",
          "type": "select",
          "values": ["500000", "1000000"],
          "default": "1000000"
        }
      ]
    }
  },
  "bootloaderOffsets": {
    "none": {
      "label": "No bootloader",
      "flashAddress": "0x08000000",
      "config": {
        "CONFIG_STM32_FLASH_START_0000": "y"
      }
    },
    "8KiB": {
      "label": "8KiB bootloader",
      "flashAddress": "0x08002000",
      "config": {
        "CONFIG_STM32_FLASH_START_2000": "y"
      }
    }
  },
  "clockRefs": {
    "8MHz": {
      "label": "8MHz crystal"
    }
  }
}
