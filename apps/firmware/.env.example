# Build backend: "docker" (sandboxed container, default) or "process" (direct
# host spawn — trusted host only, no network/memory/CPU isolation; `make` plus
# the target toolchain must be on PATH).
# BUILD_ADAPTER=docker

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: Klipper git clone location (default: ./data/klipper)
# KLIPPER_SOURCE_PATH=./data/klipper

# Optional: Docker socket and builder image (Docker adapter only)
# DOCKER_SOCKET=/var/run/docker.sock
# BUILDER_IMAGE=klipperforge-builder:latest

# Optional: Concurrency and timeouts
# MAX_CONCURRENT_BUILDS=2
# MAX_PENDING_BUILDS=20
# BUILD_TIMEOUT_MS=120000

# Optional: Per-build container limits (Docker adapter only)
# BUILD_CPUS=1
# BUILD_MEMORY_MB=384

# Optional: Rate limiting
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Build cache eviction
# CACHE_MAX_ENTRIES=500
# CACHE_MAX_SIZE_MB=200
# CACHE_TTL_SECONDS=604800
# CACHE_EVICT_STALE_COMMITS=true
