# Required: GitHub OAuth App credentials
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret

# Required: Secret for signing session JWTs
# SESSION_SECRET=your_random_secret_at_least_32_chars

# Optional: Override callback URL (default: http://localhost:3002/api/auth/github/callback)
# GITHUB_CALLBACK_URL=http://localhost:3002/api/auth/github/callback

# Optional: Frontend URL for redirect after login (default: http://localhost:5173)
# APP_URL=http://localhost:5173

# Optional: Server port (default: 3002)
# PORT=3002

# Optional: Database path (default: ./data/db/configs.sqlite)
# DB_PATH=./data/db/configs.sqlite

# Optional: Rate limiting
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Quotas
# MAX_CONFIGS_PER_USER=50
# MAX_REVISIONS_PER_CONFIG=100
# MAX_DOCUMENT_SIZE_BYTES=65536
