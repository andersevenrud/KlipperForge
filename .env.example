# GitHub OAuth (required for config storage)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session encryption (required)
SESSION_SECRET=

# App URL (used for OAuth redirect and CORS)
APP_URL=http://localhost
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# Port nginx listens on (host side)
APP_PORT=80

# Firmware builder settings
MAX_CONCURRENT_BUILDS=2
MAX_PENDING_BUILDS=20
BUILD_TIMEOUT_MS=120000

# Rate limiting
FIRMWARE_RATE_LIMIT_MAX_REQUESTS=5
FIRMWARE_RATE_LIMIT_WINDOW_SECONDS=60
CONFIGS_RATE_LIMIT_MAX_REQUESTS=30
CONFIGS_RATE_LIMIT_WINDOW_SECONDS=60

# Build cache eviction
CACHE_MAX_ENTRIES=500
CACHE_MAX_SIZE_MB=200
CACHE_TTL_SECONDS=604800
CACHE_EVICT_STALE_COMMITS=true

# Config storage quotas
MAX_CONFIGS_PER_USER=50
MAX_REVISIONS_PER_CONFIG=100
MAX_DOCUMENT_SIZE_BYTES=65536
SESSION_MAX_AGE_DAYS=30
